#autoload
# clear() — context-aware screen clear.
# Outside zellij ($ZELLIJ empty): raw ANSI via printf instead of `command
#   clear`, avoiding ncurses so conda's broken terminfo can't trigger
#   "terminals database is inaccessible". \033[H home, \033[2J clear screen,
#   \033[3J clear scrollback (ghostty supports 3J).
# Inside zellij: unchanged — archive the pane, then `zellij action clear`,
#   the only thing that clears zellij's own 50k scroll buffer.
function clear() {
  if [[ -z "$ZELLIJ" ]]; then
    printf '\033[H\033[2J\033[3J'
    return
  fi

  if ((_ZJ_DID_WORK)); then
    local tmp
    tmp=$(mktemp)
    zellij action dump-screen --full --path "$tmp"
    if [[ -s "$tmp" ]]; then
      mkdir -p "$ZELLIJ_SCROLLBACK_DIR"
      (
        flock 9
        {
          print -r -- "===== cleared $(date '+%Y-%m-%d %H:%M:%S') | session=${ZELLIJ_SESSION_NAME:-?} pid=$$ ====="
          cat "$tmp"
        } >&9
      ) 9>>"$ZELLIJ_SCROLLBACK_ARCHIVE"
    fi
    rm -f "$tmp"
  fi
  _ZJ_DID_WORK=0

  _zj_housekeeping_check
  command zellij action clear
}
