[Unit]
Description=Notice when the desktop's backup missed its nightly run or has grown old
Documentation=file:///home/filipejunqueira/.local/bin/backup-desktop-age-check

[Service]
Type=oneshot
ExecStart=%h/.local/bin/backup-desktop-age-check

# Exit 1 means "something reported", a normal outcome, not a fault. Exit 2 (could not tell) is
# left out on purpose, so a check that cannot read the journal shows in `systemctl --user status`.
SuccessExitStatus=0 1

# The phone alert reads its topic with `pass`, which works under a unit only with these two lines,
# the same two as the laptop's backup-age-check.service. The screen notification needs the
# session bus.
Environment=PASSWORD_STORE_DIR=%h/.local/share/pass
Environment=GNUPGHOME=%h/.local/share/gnupg
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
