// ── UI ────────────────────────────────────────────────────────────
simplified_ui true
default_layout "default"
pane_frames false
auto_layout true
mouse_mode true
copy_on_select false
styled_underlines true
show_release_notes false
session_serialization true

// ── Gruvbox Dark theme ────────────────────────────────────────────
themes {
    gruvbox-dark {
        fg 213 196 161
        bg 40 40 40
        red 204 36 29
        green 152 151 26
        yellow 215 153 33
        blue 69 133 136
        magenta 177 98 134
        orange 214 93 14
        cyan 104 157 106
        black 29 32 33
        white 235 219 178
    }

    ember {
        fg          "#d8d0c0"
        bg          "#1c1b19"
        black       "#242320"
        red         "#e08060"
        green       "#8a9868"
        yellow      "#c8b468"
        blue        "#7890a0"
        magenta     "#988090"
        cyan        "#80a090"
        white       "#d8d0c0"
        orange      "#c09058"
    }

    ember-soft {
        fg          "#d8d0c0"
        bg          "#242320"
        black       "#1c1b19"
        red         "#e08060"
        green       "#8a9868"
        yellow      "#c8b468"
        blue        "#7890a0"
        magenta     "#988090"
        cyan        "#80a090"
        white       "#d8d0c0"
        orange      "#c09058"
    }

    ember-light {
        fg          "#282418"
        bg          "#e6dac4"
        black       "#282418"
        red         "#b84c30"
        green       "#4a6830"
        yellow      "#7a6820"
        blue        "#3a6080"
        magenta     "#706070"
        cyan        "#386858"
        white       "#e6dac4"
        orange      "#946030"
    }
}
//theme "gruvbox-dark"
theme "ember"
// ── Keybinds (defaults, only overrides here) ──────────────────────
keybinds {
    // keeping all defaults
}

// ── Plugins ───────────────────────────────────────────────────────
plugins {
    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    compact-bar location="zellij:compact-bar"
    session-manager location="zellij:session-manager"
    configuration location="zellij:configuration"
    plugin-manager location="zellij:plugin-manager"
}
