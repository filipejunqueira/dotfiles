layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left  "{mode} #[fg=#d5c4a1,bold]{session} {tabs}"
                format_right "{datetime}"
                format_space ""
                format_hide_on_overlength "true"
                format_precedence "lrc"

                border_enabled  "false"

                mode_normal  "#[bg=#98971a,fg=#282828,bold]  NORMAL "
                mode_locked  "#[bg=#928374,fg=#282828,bold]  LOCKED "
                mode_pane    "#[bg=#458588,fg=#282828,bold]  PANE "
                mode_tab     "#[bg=#d79921,fg=#282828,bold]  TAB "
                mode_resize  "#[bg=#cc241d,fg=#282828,bold]  RESIZE "
                mode_scroll  "#[bg=#689d6a,fg=#282828,bold]  SCROLL "
                mode_session "#[bg=#b16286,fg=#282828,bold]  SESSION "
                mode_move    "#[bg=#d65d0e,fg=#282828,bold]  MOVE "
                mode_tmux    "#[bg=#d79921,fg=#282828,bold]  TMUX "

                tab_normal              "#[fg=#928374] {name} "
                tab_normal_fullscreen   "#[fg=#928374] {name}  "
                tab_normal_sync         "#[fg=#928374] {name}  "
                tab_active              "#[fg=#d5c4a1,bold] {name} "
                tab_active_fullscreen   "#[fg=#d5c4a1,bold] {name}  "
                tab_active_sync         "#[fg=#d5c4a1,bold] {name}  "

                datetime          "#[fg=#928374] {format} "
                datetime_format   "%H:%M"
                datetime_timezone "Europe/London"
            }
        }
    }
}
