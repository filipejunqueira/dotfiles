#!/usr/bin/env bash
# backup-age-check -- notice when the laptop's Borg backup missed a scheduled run, or has grown
# old, and say so on the screen and on the phone.
#
# Installed as ~/.local/bin/backup-age-check by pending/laptop-hardening/05_age_check_land.sh and
# run by backup-age-check.timer (PLAN-laptop-hardening.md action 13). Modelled on
# ~/code/nhs-hour-log/scripts/check-staleness.sh.
#
# STRICTLY READ-ONLY. It reads the user journal of backup-home.service and asks systemd about the
# backup timer. It never starts, stops or changes a unit.
#
# Two questions (plan decision 9):
#   - has a backup completed since the last scheduled time that is at least GRACE_MINUTES past?
#     The grace lets a run that is still going finish before it counts as missed.
#   - is the newest completed backup under BACKUP_AGE_MAX_HOURS old?
# What it reads (age_check_measured.md items 1 to 3): the newest line of backup-home.sh's own
# "[backup] Backup complete: <archive>" in the journal, with its time as seconds since 1970.
# Nothing found, a time it cannot read, or a time in the future is an alert, never a pass.
# A backup run by hand through backup-catchup is not in that journal (plan finding 20), so after
# one the check may still alert: the safe direction.
#
# Usage: backup-age-check [--force-notify]
# Env:   BACKUP_AGE_MAX_HOURS  how old the newest backup may be (default 48)
# Exit:  0 nothing to say . 1 something reported . 2 could not tell (also reported)

set -euo pipefail

# The backup timer's schedule, written here a second time (plan decision 9). The landing script
# compares these with what `systemctl --user show backup-home.timer` reports and refuses if they
# differ, so change both together.
BACKUP_DAYS="Tue Thu Sat Sun"
BACKUP_TIMES="11:00 15:00 19:00"
GRACE_MINUTES=90

MAX_HOURS="${BACKUP_AGE_MAX_HOURS:-48}"
PATTERN='\[backup\] Backup complete: '
FORCE=0

for arg in "$@"; do
    case "$arg" in
        --force-notify) FORCE=1 ;;
        -h|--help) sed -n '2,24p' "$(readlink -f "${BASH_SOURCE[0]}")"; exit 0 ;;
        *) echo "unknown argument: $arg" >&2; exit 2 ;;
    esac
done
case "$MAX_HOURS" in
    ''|*[!0-9]*) echo "BACKUP_AGE_MAX_HOURS is not a whole number: '$MAX_HOURS'" >&2; exit 2 ;;
esac

say() { echo "$*"; }

# The screen first, then the phone, each best-effort: neither may fail the run, and the phone
# alert's topic is read at run time and never printed. Under the unit, notify-send needs the
# session bus and pass needs PASSWORD_STORE_DIR and GNUPGHOME (backup-age-check.service).
notify() {
    local title="$1" body="$2" topic=""
    say "$title -- $body"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send --app-name="backup-age-check" --urgency=critical "$title" "$body" || true
    fi
    topic="$(pass show api/ntfy-desktop-events 2>/dev/null | head -n1)" || topic=""
    if [ -z "$topic" ]; then
        say "phone alert not sent: pass gave no topic"
        return 0
    fi
    curl -s -m 10 -d "$title -- $body" "ntfy.sh/${topic}" >/dev/null 2>&1 \
        || say "phone alert not sent: curl failed"
}

# hm <seconds> -- "12.3" hours, for the text.
hm() { awk -v s="$1" 'BEGIN { printf "%.1f", s / 3600 }'; }
when() { date -d "@$1" '+%a %Y-%m-%d %H:%M'; }

# The timer's state and next run as systemd reports them, for the alert text only.
timer_state() {
    local out
    out="$(systemctl --user show backup-home.timer -p ActiveState -p NextElapseUSecRealtime 2>/dev/null)" \
        || out=""
    [ -n "$out" ] || out="systemd gave no answer"
    printf '%s' "$out" | tr '\n' ' '
}

NOW="$(date +%s)"

# last_due_slot -- the newest scheduled time S with S + GRACE_MINUTES <= NOW, looking back eight
# days. Prints nothing if there is none.
last_due_slot() {
    local today d day dow t s
    today="$(date -d "@$NOW" +%F)"
    for d in 0 1 2 3 4 5 6 7 8; do
        day="$(date -d "$today -$d days" +%F)"
        dow="$(LC_ALL=C date -d "$day" +%a)"
        case " $BACKUP_DAYS " in *" $dow "*) ;; *) continue ;; esac
        for t in $(printf '%s\n' $BACKUP_TIMES | sort -r); do
            s="$(date -d "$day $t" +%s)"
            if [ $((s + GRACE_MINUTES * 60)) -le "$NOW" ]; then
                printf '%s' "$s"
                return 0
            fi
        done
    done
}

ask_journal() {
    journalctl -q --user -u backup-home.service -g "$PATTERN" -r -n1 -o short-unix --no-pager
}
line=""
err=""
rc=0
# Asked twice, once for the answer and once for any complaint, so that no file is needed to keep
# the two apart.
line="$(ask_journal 2>/dev/null)" || rc=$?
err="$(ask_journal 2>&1 >/dev/null)" || true

# journalctl exits 1 both for "no line matched" and for "could not read the journal", and 0 with
# an empty answer for a unit it does not know (age_check_measured.md item 3). So stderr decides
# "could not tell", and an empty answer is never a pass.
if [ -n "$err" ]; then
    notify "Backup check: could not read the journal" \
"journalctl said: $(printf '%s' "$err" | head -c 300 | tr '\n' ' ') (exit $rc). Timer: $(timer_state)"
    exit 2
fi
if [ -z "$line" ]; then
    notify "Laptop backup: no completed backup on record" \
"The journal of backup-home.service holds no '[backup] Backup complete:' line. Timer: $(timer_state)"
    exit 1
fi

stamp="${line%% *}"
case "$stamp" in
    [0-9]*.[0-9]*|[0-9]*) ;;
    *) stamp="" ;;
esac
newest="${stamp%%.*}"
case "$newest" in
    ''|*[!0-9]*)
        notify "Backup check: could not read the time of the newest backup" \
"The journal line was: ${line:0:200}. Timer: $(timer_state)"
        exit 2 ;;
esac
if [ "$newest" -gt "$NOW" ]; then
    notify "Backup check: the newest backup is dated in the future" \
"$(when "$newest") is after now, $(when "$NOW"). Timer: $(timer_state)"
    exit 2
fi

age=$((NOW - newest))
say "newest completed backup: $(when "$newest") ($(hm "$age") h ago; limit ${MAX_HOURS} h)"

slot="$(last_due_slot)"
if [ -z "$slot" ]; then
    notify "Backup check: could not work out the last scheduled time" \
"Days '$BACKUP_DAYS', times '$BACKUP_TIMES'. Newest backup $(when "$newest"). Timer: $(timer_state)"
    exit 2
fi

problems=()
if [ "$newest" -lt "$slot" ]; then
    problems+=("no backup has completed since the one scheduled for $(when "$slot")")
fi
if [ "$age" -gt $((MAX_HOURS * 3600)) ]; then
    problems+=("the newest backup is $(hm "$age") hours old, over the limit of ${MAX_HOURS}")
fi
if [ "$FORCE" -eq 1 ] && [ "${#problems[@]}" -eq 0 ]; then
    problems+=("a test alert (--force-notify); nothing is wrong")
fi

if [ "${#problems[@]}" -eq 0 ]; then
    say "up to date: completed after the scheduled time of $(when "$slot")"
    exit 0
fi
body="${problems[0]}"
for p in "${problems[@]:1}"; do body="$body; $p"; done
notify "Laptop backup: $body" \
"Newest completed backup $(when "$newest"), $(hm "$age") hours ago (limit ${MAX_HOURS}). Timer: $(timer_state)"
exit 1
