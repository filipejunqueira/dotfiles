#!/usr/bin/env bash
set -euo pipefail

# ─── Configuration ───────────────────────────────────────
CONTAINER_NAME="claude-sandbox"

# ─── Colours ─────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

# ─── Functions ───────────────────────────────────────────
usage() {
    cat <<EOF
Usage: cc [OPTIONS] [-- claude-args...]

Sandboxed Claude Code launcher.

Options:
  -u, --update        Update Claude Code inside the container
  -l, --login         Run claude auth login (OAuth via browser)
  -e, --enter         Enter the container shell (no Claude Code)
  -f, --fleet         Open the session roster (FleetView) instead of a new session
      --global-config Start in the config repository, ~/containers/claude-home/.claude
      --no-teams      Agent teams off for this launch only; \`claude-teams status\` still
                      reads the folder's own setting
  -h, --help          Show this help


Examples:
  cc                  New session in the current directory
  cc --global-config  New session in the config repository, from any folder
  cc -n myname        New session named myname (-n is claude's own --name)
  cc -f               Pick from running sessions instead
  cc -u               Update Claude Code to latest
  cc -l               Re-authenticate via browser
  cc -e               Drop into container shell
  cc -- --resume      Pass flags through to claude

EOF
}

check_container() {
    local _list
    _list="$(distrobox list)"
    if ! grep -q "$CONTAINER_NAME" <<<"$_list"; then
        echo -e "${RED}Container '$CONTAINER_NAME' not found.${NC}"
        echo "Create it first (see setup guide)."
        exit 1
    fi
}

# Every `distrobox enter` takes -nw: without it distrobox builds --workdir from $PWD into
# an option list it later splits on newlines, so a folder name holding a newline would
# add options of its own to `podman exec`. The folder goes over as an argument instead.
enter_shell() {
    # The login shell distrobox itself starts when given no command.
    distrobox enter -nw "$CONTAINER_NAME" -- bash -c 'cd -- "$1" || exit 1
s="$(getent passwd "$(id -un)" | cut -d: -f7)"
exec "${s:-/bin/bash}" -l' ccode "$PWD"
}

update_claude() {
    echo -e "${YELLOW}Updating Claude Code...${NC}"
    distrobox enter -nw "$CONTAINER_NAME" -- bash -c 'export PATH="$HOME/.local/bin:$PATH"; curl -fsSL https://claude.ai/install.sh | bash'
    echo -e "${GREEN}Done. New version:${NC}"
    distrobox enter -nw "$CONTAINER_NAME" -- bash -c 'export PATH="$HOME/.local/bin:$PATH"; claude --version'
}

run_login() {
    distrobox enter -nw "$CONTAINER_NAME" -- bash -c 'export PATH="$HOME/.local/bin:$PATH"; claude auth login'
}

run_claude() {
    local host_cwd="$START_DIR"
    local -a args=()
    # A passthrough that already picks a session wins. `--session-id <new>` alongside
    # --resume or --continue is a contradiction, so do not inject one on top of them.
    # The word after -n or --name is a name, whatever it looks like.
    local a prev="" picks_session=0 own_settings=0
    for a in "$@"; do
        if [[ $prev != -n && $prev != --name ]]; then
            case "$a" in
            -r | --resume | -c | --continue | --session-id | --fork-session) picks_session=1 ;;
            --settings | --settings=*) own_settings=1 ;;
            esac
        fi
        prev="$a"
    done
    # claude keeps the last --settings it is given, so one of his own would undo this.
    if ((NO_TEAMS && own_settings)); then
        echo -e "${RED}ccode: --no-teams cannot go with a --settings of your own; put the teams variable in that file${NC}" >&2
        exit 1
    fi
    ((NEW_SESSION && !picks_session)) && args+=(--session-id "$(uuidgen)")
    ((NO_TEAMS)) && args+=(--settings '{"env":{"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS":"0"}}')
    args+=("$@")
    # The folder and the arguments travel as arguments, never as shell text: a folder named
    # `a$(cmd)b` would otherwise run cmd. distrobox hands them on to `podman exec` whole.
    distrobox enter -nw "$CONTAINER_NAME" -- bash -c 'export PATH="$HOME/.local/bin:$PATH"
cd -- "$1" || { echo "ccode: the container cannot enter $1" >&2; exit 1; }
shift
claude "$@"' ccode "$host_cwd" "${args[@]}"
}

render_claude_json() {
    # 13d.1 script 12: .claude.json comes from a template in dotfiles-private; the Context7 key
    # lives in pass. Render only when the template is newer than the live file or the file is
    # absent — Claude Code rewrites .claude.json on exit and that copy must never be clobbered.
    local tmpl="$HOME/.dotfiles-private/claude/claude.json.template"
    local out="$HOME/containers/claude-home/.claude.json"
    [[ -f "$tmpl" ]] || return 0
    if [[ ! -f "$out" || "$tmpl" -nt "$out" ]]; then
        local key
        if ! key="$(pass show api/context7 2>/dev/null)"; then
            echo -e "${YELLOW}pass show api/context7 failed — .claude.json not rendered${NC}"
            return 0
        fi
        (
            umask 077
            sed "s|__CONTEXT7_KEY__|$key|" "$tmpl" >"$out.tmp"
        ) && mv -f "$out.tmp" "$out"
        echo -e "${GREEN}Rendered $out from the template${NC}"
    fi
}

# ─── Argument parsing ────────────────────────────────────
ACTION="run"
# A FRESH SESSION IS THE DEFAULT. Launching with no session id lands in FleetView, the
# roster of running sessions, which is the rarer thing to want and was reachable only by
# accident before: an empty '' argument used to suppress it, and removing that stray
# argument on 2026-09-20 exposed the picker on every bare `cc`. -f asks for it on purpose.
NEW_SESSION=1
# The folder the session starts in. --global-config swaps it for the config repository,
# so that one command opens it from anywhere.
START_DIR="$PWD"
# --settings sits above every settings file, so it beats a folder's own teams setting.
NO_TEAMS=0
CLAUDE_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
    -u | --update)
        ACTION="update"
        shift
        ;;
    -l | --login)
        ACTION="login"
        shift
        ;;
    -e | --enter)
        ACTION="enter"
        shift
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    --)
        shift
        CLAUDE_ARGS+=("$@")
        break
        ;;
    --no-teams)
        NO_TEAMS=1
        shift
        ;;
    --new)
        # Retired with -n, which is claude's own --name now; a new session is the default.
        echo -e "${YELLOW}ccode: --new is retired; a new session is the default${NC}" >&2
        shift
        ;;
    --global-config)
        START_DIR="$HOME/containers/claude-home/.claude"
        shift
        ;;
    -f | --fleet)
        # NOT -p: claude's own -p/--print is far too common to shadow. `cc -- -p '...'`
        # must keep meaning claude's print flag.
        NEW_SESSION=0
        shift
        ;;
    *)
        CLAUDE_ARGS+=("$1")
        shift
        ;;
    esac
done

# ─── Execute ─────────────────────────────────────────────
render_claude_json
check_container

case "$ACTION" in
update) update_claude ;;
login) run_login ;;
enter) enter_shell ;;
run) run_claude "${CLAUDE_ARGS[@]}" ;;
esac
