#!/usr/bin/env bash
# ── chill freq-cap bench ── run on AC. Loads all cores ~20s (warm/loud briefly).
CPUFREQ=/sys/devices/system/cpu/cpu0/cpufreq
[ -d "$CPUFREQ" ] || { echo "❌ no cpufreq sysfs — amd_pstate not active?"; exit 1; }
sudo -v || { echo "❌ sudo needed"; exit 1; }

echo "=== 1. CPU IDENTITY / BASE CLOCK ==="
lscpu | grep -iE 'model name|CPU\(s\):|max MHz|min MHz' | sed 's/^/  /'
echo "  --- cpufreq sysfs (KHz) ---"
printf "  cpuinfo_min=%s  cpuinfo_max=%s  base_frequency=%s\n" \
  "$(cat "$CPUFREQ/cpuinfo_min_freq" 2>/dev/null)" \
  "$(cat "$CPUFREQ/cpuinfo_max_freq" 2>/dev/null)" \
  "$(cat "$CPUFREQ/base_frequency" 2>/dev/null || echo n/a)"
echo "  scaling_driver=$(cat "$CPUFREQ/scaling_driver" 2>/dev/null)"
if command -v cpupower >/dev/null; then
  echo "  --- cpupower (hardware limits + AMD PSTATE Nominal = base) ---"
  cpupower frequency-info 2>/dev/null | grep -iE 'hardware limits|nominal|lowest|highest|boost' | sed 's/^/  /'
fi
echo ""

if perf list 2>/dev/null | grep -q 'power/energy-pkg/'; then PWR=perf
elif command -v turbostat >/dev/null; then PWR=turbostat
elif [ -r /sys/class/power_supply/BAT0/power_now ]; then PWR=battery
else PWR=none; fi
echo "=== 2. POWER METHOD: $PWR ==="
[ "$PWR" = none ] && echo "  ⚠️ no package-power counter; reporting Tctl temp only as proxy"
[ "$PWR" = battery ] && echo "  ⚠️ battery method = whole-system draw, only meaningful UNPLUGGED"
echo ""

LOAD_PIDS=()
start_load() {
  if command -v stress-ng >/dev/null; then stress-ng -c 0 -t 900 >/dev/null 2>&1 & LOAD_PIDS=($!)
  else local i; for i in $(seq "$(nproc)"); do ( while :; do :; done ) & LOAD_PIDS+=($!); done; fi
}
stop_load() { [ "${#LOAD_PIDS[@]}" -gt 0 ] && kill "${LOAD_PIDS[@]}" 2>/dev/null; LOAD_PIDS=(); }

measure() {
  local tag="$1" win=5 pkg="n/a" avg max tctl cap
  start_load; sleep 2
  if [ "$PWR" = perf ]; then
    pkg=$(sudo perf stat -a -e power/energy-pkg/ -- sleep "$win" 2>&1 | awk '/Joules/{gsub(/,/,"",$1); printf "%.1f W", $1/'"$win"'}')
  elif [ "$PWR" = turbostat ]; then
    pkg=$(sudo turbostat --quiet --show PkgWatt --interval 1 sleep "$win" 2>/dev/null | awk '($1+0==$1)&&NF==1{s+=$1;n++} END{if(n)printf "%.1f W", s/n}')
  elif [ "$PWR" = battery ]; then
    sleep "$win"; pkg=$(awk '{printf "%.1f W", $1/1e6}' /sys/class/power_supply/BAT0/power_now)
  else sleep "$win"; fi
  avg=$(cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq | awk '{s+=$1;n++} END{printf "%.0f", s/n/1000}')
  max=$(cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq | awk '{if($1>m)m=$1} END{printf "%.0f", m/1000}')
  tctl=$(sensors 2>/dev/null | awk '/Tctl:/{print $2; exit}')
  stop_load
  cap=$(awk '{printf "%.0f", $1/1000}' "$CPUFREQ/scaling_max_freq")
  printf "  %-18s cap=%-5s MHz | clk avg=%-5s max=%-5s MHz | pkg=%-9s | Tctl=%s\n" \
    "$tag" "$cap" "$avg" "$max" "${pkg:-n/a}" "${tctl:-?}"
}

ORIG=$(cat "$CPUFREQ/scaling_max_freq")
HWMAX=$(cat "$CPUFREQ/cpuinfo_max_freq")

echo "=== 3. BENCH (each line = 5s under full load) ==="
measure "BEFORE (as-is)"

echo "  -- applying 2200 MHz cap --"
echo $((2200*1000)) | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq >/dev/null
RB=$(cat "$CPUFREQ/scaling_max_freq")
[ "$RB" = "2200000" ] && echo "  write took: scaling_max_freq=$RB ✅" || echo "  write FAILED: scaling_max_freq=$RB ⚠️"
measure "AFTER cap 2200"

echo "  -- resetting to hardware max ($HWMAX KHz) --"
echo "$HWMAX" | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq >/dev/null
measure "AFTER reset (max)"

echo "$ORIG" | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq >/dev/null
echo ""
echo "=== 4. RESTORED to your original cap ($ORIG KHz) ==="
echo "  Done. Paste sections 1–3."
