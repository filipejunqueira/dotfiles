#!/usr/bin/env bash
# monitor-off — bound to F18 on the desktop (the ROTR pad: hold middle, tap right).
# Switches the display off through Mutter's PowerSaveMode (3 = off, 0 = on), the same
# property gnome-settings-daemon uses when the blank timer runs out, so the panel goes to
# powered standby. Then it watches Mutter's idle timer and switches the display back on at
# the first input, so a dark screen never depends on Mutter waking it by itself.
# It holds no idle inhibitor and changes no blank timer: those protect the QD-OLED.
set -euo pipefail

DC=(org.gnome.Mutter.DisplayConfig /org/gnome/Mutter/DisplayConfig org.gnome.Mutter.DisplayConfig PowerSaveMode)

# idle_ms — milliseconds since the last input. busctl prints `t 1234`.
idle_ms() {
  local out
  out=$(busctl --user call org.gnome.Mutter.IdleMonitor /org/gnome/Mutter/IdleMonitor/Core \
        org.gnome.Mutter.IdleMonitor GetIdletime) || return 1
  out=${out#t }
  [[ $out =~ ^[0-9]+$ ]] || return 1
  echo "$out"
}
# mode — the current PowerSaveMode. busctl prints `i 3`.
mode() { local out; out=$(busctl --user get-property "${DC[@]}") || return 1; echo "${out#i }"; }
set_mode() { busctl --user set-property "${DC[@]}" i "$1"; }

# The key's own release comes 10 ms after the press, and it is input too: wait it out.
sleep 0.5
set_mode 3
prev=$(idle_ms) || { set_mode 0; exit 1; }
while :; do
  sleep 0.25
  now=$(idle_ms) || break                  # cannot read the timer: switch back on, below
  m=$(mode) || break
  [ "$m" = 0 ] && exit 0                   # something else has switched it on already
  [ "$now" -lt "$prev" ] && break          # input reset the idle timer
  prev=$now
done
set_mode 0
