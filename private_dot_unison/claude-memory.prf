# claude-memory.prf -- Claude Code's per-project memory and conversations, kept the same on the laptop
# and the desktop.
#
# PLAN-desktop-sessions.md decision 3 and action 9; the conversations since action 25 (decision 12).
# It lives in the LAPTOP's ~/.unison only and is
# run from there by ~/.local/bin/claude-memory-sync (claude-memory-sync.timer, every 10 minutes).
# It shares nothing with peer.prf: other roots, so other archive files and its own backup folder.
#
# Never run it bare. claude-memory-sync adds one `-path <project>` for each project folder that holds
# memory or a conversation on either machine, so a project folder that vanished from one machine is a
# `-path` that vanished, and confirmbigdel stops the run (exit 3) instead of deleting the other
# machine's copy (test_memory_sync.sh DELETE=1 case "project-folder-removed"). Run without a `-path`,
# unison would take in the whole folder of projects, and that stop would not apply.
#
# The fence: everything directly inside a project folder is ignored but three kinds of name, which
# travel with all they hold: `memory`, a conversation file `<session id>.jsonl`, and that session's
# folder `<session id>/` (its subagents, tool results and title). A session id is the 36-character
# lower-case form. So what stays behind is everything else at that level: `MEMORY.md` beside
# `memory`, `bridge-pointer.json` (one machine's Remote Control session and process id), a
# `.ruff_cache`, any dot-name (test case "what-travels"). The fence is Regex, not `Path */*`: in a
# Path pattern `*` does not match a name that begins with a dot, so `Path */*` let a `.hidden` file
# through (test case "path-pair-measured").
#
# A conversation deleted on one machine (by hand, or by Claude Code's own clean-up) is deleted on the
# other, its old copy kept under backupdir. Opening a conversation appends to its file, so the same
# conversation opened on both machines between two turns is a conflict (three_ways.md, transcripts).
#
# Conflicts are not resolved: under -batch a file changed on both machines is skipped, both copies
# stay as they are, and claude-memory-sync alerts. A file unison deletes or overwrites is kept under
# backupdir on the machine that lost it (unison_measured.md, "Which machine keeps the copy").

root = /home/filipejunqueira/containers/claude-home/.claude/projects
root = ssh://desktop//home/filipejunqueira/containers/claude-home/.claude/projects

ignore = Regex [^/]+/[^/]+
ignorenot = Regex [^/]+/memory
ignorenot = Regex [^/]+/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\.jsonl
ignorenot = Regex [^/]+/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}

# unison's own ssh connection: no reused connection (~/.ssh/config has ControlMaster auto for every
# host), no prompt, and a desktop that goes quiet mid-run is dropped instead of waited on for ever.
sshargs = -o ControlPath=none -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4
# A symbolic link inside a memory folder is not copied (measured: skipped, exit 0), so nothing on one
# machine can point a session on the other at a file outside its memory.
links = false

times = true
backup = Name *
backuploc = central
backupdir = /home/filipejunqueira/.unison-backups-claude-memory
maxbackups = 3
confirmbigdel = true
